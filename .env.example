# GEMINI_API_KEY: server-side AI API key for Google Gemini
# GOOGLE_API_KEY is also supported.
# AI_PROVIDER is optional; supported value: google
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
AI_PROVIDER="google"

# GitHub token with pull request read access. Private repos need repo access.
GITHUB_TOKEN="YOUR_GITHUB_TOKEN"

# Notion integration secret and database ID for engineering standards / ADRs.
NOTION_API_KEY="YOUR_NOTION_API_KEY"
NOTION_DATABASE_ID="YOUR_NOTION_DATABASE_ID"

# CORS origins allowed to call the backend.
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Local server port for Express.
PORT="3000"
